<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.CrearAdminController" prefWidth="400" prefHeight="300"
            style="-fx-background-color: linear-gradient(to bottom, #1e3c72, #2a5298);">
    <children>
        <VBox spacing="10" alignment="CENTER" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
              AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0">
            <children>
                <Label text="Crear Administrador" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                <TextField fx:id="txtUsuario" promptText="Usuario" maxWidth="200"/>
                <PasswordField fx:id="txtPassword" promptText="Contraseña" maxWidth="200"/>
                <PasswordField fx:id="txtConfirm" promptText="Confirmar Contraseña" maxWidth="200"/>
                <Button text="Crear" onAction="#handleCrear" maxWidth="200"/>
            </children>
        </VBox>
    </children>
</AnchorPane>