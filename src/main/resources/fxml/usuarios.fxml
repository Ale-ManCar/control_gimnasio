<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.UsuariosController"
      spacing="10" prefWidth="700" prefHeight="500"
      style="-fx-background-color: linear-gradient(to bottom, #2c3e50, #1a1a2e); -fx-padding: 20;">
    <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS"
               style="-fx-background-color: rgba(255,255,255,0.1); -fx-border-color: rgba(255,255,255,0.2);">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colRol" text="Rol" prefWidth="150" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colActivo" text="Estado" prefWidth="100" style="-fx-alignment: CENTER;"/>
        </columns>
    </TableView>
    <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <TextField fx:id="txtNombre" promptText="Nombre"
                       style="-fx-background-radius: 5; -fx-padding: 8;"/>
            <PasswordField fx:id="txtPassword" promptText="Contraseña"
                           style="-fx-background-radius: 5; -fx-padding: 8;"/>
            <ComboBox fx:id="cbRol" promptText="Rol"/>
            <CheckBox fx:id="chkActivo" text="Activo" selected="true"/>
        </VBox>
        <VBox spacing="10" alignment="CENTER">
            <Button text="Nuevo" onAction="#nuevoUsuario"
                    style="-fx-background-color: #6C757D; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 20;"/>
            <Button text="Guardar" onAction="#guardarUsuario"
                    style="-fx-background-color: #4A6CF7; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 20;"/>
            <Button text="Eliminar" onAction="#eliminarUsuario"
                    style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 20;"/>
        </VBox>
    </HBox>
</VBox>