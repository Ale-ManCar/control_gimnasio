<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.UsuariosController"
      spacing="10" prefWidth="700" prefHeight="500"
      stylesheets="@../css/dashboard_admin.css" styleClass="dashboard-root">
    <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200" />
            <TableColumn fx:id="colRol" text="Rol" prefWidth="150" />
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="100" />
            <TableColumn fx:id="colUltimoIngreso" text="Último ingreso" prefWidth="200" />
        </columns>
    </TableView>
    <HBox spacing="20" alignment="CENTER_LEFT">
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <TextField fx:id="txtNombre" promptText="Nombre" />
            <PasswordField fx:id="txtPassword" promptText="Contraseña" />
            <ComboBox fx:id="cmbRol" promptText="Rol" />
            <CheckBox fx:id="chkActivo" text="Activo" selected="true" />
        </VBox>
        <VBox spacing="10" alignment="CENTER">
            <Button fx:id="btnNuevo" text="Nuevo" onAction="#nuevoUsuario" />
            <Button fx:id="btnGuardar" text="Guardar" onAction="#guardarUsuario" />
            <Button fx:id="btnEliminar" text="Activar/Desactivar" onAction="#cambiarEstadoUsuario" />
            <Button fx:id="btnResetPass" text="Reset Pass" onAction="#resetearPassword" />
        </VBox>
    </HBox>
</VBox>