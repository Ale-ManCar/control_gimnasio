<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import java.net.URL?>
<?import java.lang.String?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AuditoriaController" prefWidth="1100" prefHeight="650"
            styleClass="auditoria-root">
    <stylesheets>
        <URL value="@../css/auditoria.css"/>
    </stylesheets>
    <center>
        <VBox styleClass="auditoria-content" spacing="24">
            <Label text="Historial de resúmenes" styleClass="view-title"/>

            <VBox styleClass="card" spacing="18">
                <Label text="Filtros" styleClass="card-title"/>
                <FlowPane styleClass="filters-flow" prefWrapLength="920">
                    <children>
                        <VBox spacing="6" styleClass="filter-field">
                            <Label text="Recepcionista" styleClass="card-subtitle"/>
                            <ComboBox fx:id="cbUsuarios" promptText="Todos" prefWidth="220"/>
                        </VBox>
                        <VBox spacing="6" styleClass="filter-field">
                            <Label text="Año" styleClass="card-subtitle"/>
                            <ComboBox fx:id="cbAnio" promptText="Todos" prefWidth="120"/>
                        </VBox>
                        <VBox spacing="6" styleClass="filter-field">
                            <Label text="Mes" styleClass="card-subtitle"/>
                            <ComboBox fx:id="cbMes" promptText="Todos" prefWidth="150"/>
                        </VBox>
                        <VBox spacing="6" styleClass="filter-field">
                            <Label text="Tipo de resumen" styleClass="card-subtitle"/>
                            <ComboBox fx:id="cbTipo" promptText="Todos" prefWidth="200"/>
                        </VBox>
                    </children>
                </FlowPane>
                <HBox styleClass="section-actions">
                    <children>
                        <Button text="Aplicar filtros" onAction="#aplicarFiltros" styleClass="primary-button"/>
                        <Button text="Limpiar" onAction="#limpiarFiltros" styleClass="secondary-outline-button"/>
                    </children>
                </HBox>
            </VBox>

            <VBox styleClass="card table-card">
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <children>
                        <Label text="Eventos registrados" styleClass="card-title-light"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnVer" text="Ver PDF" onAction="#verSeleccion" styleClass="primary-button"/>
                        <Button fx:id="btnDescargar" text="Descargar PDF" onAction="#descargarSeleccion" styleClass="primary-button"/>
                        <Button text="Exportar historial" onAction="#exportarReporte" styleClass="primary-button"/>
                    </children>
                </HBox>
                <SplitPane dividerPositions="0.32">
                    <items>
                        <VBox spacing="12" prefWidth="300">
                            <padding>
                                <Insets top="8" right="12" bottom="8" left="4"/>
                            </padding>
                            <children>
                                <Label text="Resúmenes generados" styleClass="card-subtitle-light"/>
                                <TreeView fx:id="treeResumenes" VBox.vgrow="ALWAYS"/>
                            </children>
                        </VBox>
                        <VBox spacing="12">
                            <padding>
                                <Insets top="8" right="4" bottom="8" left="4"/>
                            </padding>
                            <children>
                                <TableView fx:id="tablaAuditoria" VBox.vgrow="ALWAYS">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                                    </columnResizePolicy>
                                    <styleClass>
                                        <String fx:value="auditoria-table"/>
                                    </styleClass>
                                    <columns>
                                        <TableColumn fx:id="colId" text="ID" style="-fx-alignment: CENTER;"/>
                                        <TableColumn fx:id="colUsuario" text="Recepcionista" style="-fx-alignment: CENTER;"/>
                                        <TableColumn fx:id="colAccion" text="Tipo" style="-fx-alignment: CENTER;"/>
                                        <TableColumn fx:id="colDetalle" text="Archivo" style="-fx-alignment: CENTER;"/>
                                        <TableColumn fx:id="colFecha" text="Fecha" style="-fx-alignment: CENTER;"/>
                                        <TableColumn fx:id="colAcciones" text="Acciones" style="-fx-alignment: CENTER;"/>
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </items>
                </SplitPane>
            </VBox>
        </VBox>
    </center>
</BorderPane>