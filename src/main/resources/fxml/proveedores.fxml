<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.ProveedoresController"
      spacing="10" prefWidth="800" prefHeight="600"
      style="-fx-background-color: linear-gradient(to bottom, #2c3e50, #1a1a2e); -fx-padding: 20;">
    <TableView fx:id="tablaProveedores" VBox.vgrow="ALWAYS"
               style="-fx-background-color: rgba(255,255,255,0.1); -fx-border-color: rgba(255,255,255,0.2);">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="120" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="180" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="100" style="-fx-alignment: CENTER;"/>
        </columns>
    </TableView>
    <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <TextField fx:id="txtNombre" promptText="Nombre"
                       style="-fx-background-radius: 5; -fx-padding: 8;"/>
            <TextField fx:id="txtTelefono" promptText="Teléfono"
                       style="-fx-background-radius: 5; -fx-padding: 8;"/>
            <TextField fx:id="txtEmail" promptText="Email"
                       style="-fx-background-radius: 5; -fx-padding: 8;"/>
            <CheckBox fx:id="chkActivo" text="Activo" selected="true"/>
        </VBox>
        <VBox spacing="10" alignment="CENTER">
            <Button text="Nuevo" onAction="#nuevoProveedor"
                    style="-fx-background-color: #6C757D; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 20;"/>
            <Button text="Guardar" onAction="#guardarProveedor"
                    style="-fx-background-color: #4A6CF7; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 20;"/>
        </VBox>
    </HBox>
    <Label text="Cotizaciones" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
    <TableView fx:id="tablaCotizaciones" prefHeight="200"
               style="-fx-background-color: rgba(255,255,255,0.1); -fx-border-color: rgba(255,255,255,0.2);">
        <columns>
            <TableColumn fx:id="colCotProducto" text="Producto" prefWidth="150" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colCotPresentacion" text="Presentación" prefWidth="120" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colCotPrecio" text="Precio" prefWidth="100" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colCotVigencia" text="Vigencia" prefWidth="120" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colCotCondiciones" text="Condiciones" prefWidth="200" style="-fx-alignment: CENTER;"/>
        </columns>
    </TableView>
    <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <ComboBox fx:id="cbProducto" promptText="Producto"/>
            <TextField fx:id="txtPresentacionCot" promptText="Presentación"
                       style="-fx-background-radius: 5; -fx-padding: 8;"/>
            <TextField fx:id="txtPrecioCot" promptText="Precio"
                       style="-fx-background-radius: 5; -fx-padding: 8;"/>
            <TextField fx:id="txtVigenciaCot" promptText="Vigencia"
                       style="-fx-background-radius: 5; -fx-padding: 8;"/>
            <TextField fx:id="txtCondicionesCot" promptText="Condiciones"
                       style="-fx-background-radius: 5; -fx-padding: 8;"/>
        </VBox>
        <VBox spacing="10" alignment="CENTER">
            <Button text="Nueva" onAction="#nuevaCotizacion"
                    style="-fx-background-color: #6C757D; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 20;"/>
            <Button text="Guardar" onAction="#guardarCotizacion"
                    style="-fx-background-color: #4A6CF7; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-background-radius: 20;"/>
        </VBox>
    </HBox>
</VBox>