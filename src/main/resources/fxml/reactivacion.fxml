<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import javafx.geometry.Insets?>
<VBox spacing="15" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ReactivacionController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Text text="Reactivación Requerida" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Text text="Se detectó un cambio de hardware" style="-fx-font-size: 14px;"/>
    <Separator/>

    <Label text="Siga estos pasos:" style="-fx-font-weight: bold;"/>
    <Text text="1. Envíe este código al soporte técnico:"/>
    <Label fx:id="lblRequestCode" style="-fx-font-family: monospace; -fx-font-size: 14px; -fx-border-color: #ccc; -fx-padding: 5px;"/>

    <Text text="2. Ingrese el código de activación recibido:"/>
    <TextField fx:id="txtActivationCode" promptText="Código de activación"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="btnCancel" text="Cancelar" onAction="#handleCancel" style="-fx-background-color: #6c757d; -fx-text-fill: white;"/>
        <Button fx:id="btnSubmit" text="Activar" onAction="#handleSubmit" style="-fx-background-color: #28a745; -fx-text-fill: white;"/>
    </HBox>
</VBox>