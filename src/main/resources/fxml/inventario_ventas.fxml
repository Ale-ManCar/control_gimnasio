<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.InventarioController"
            prefWidth="800" prefHeight="600" style="-fx-padding: 15;">

    <top>
        <Label text="Gestión de Inventario y Ventas"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"
               alignment="CENTER" maxWidth="Infinity"/>
    </top>

    <center>
        <GridPane hgap="15" vgap="15" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
            <columnConstraints>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints percentHeight="50" vgrow="ALWAYS"/>
                <RowConstraints percentHeight="50" vgrow="ALWAYS"/>
            </rowConstraints>

            <!-- INGRESAR PRODUCTO -->
            <!--VBox style="-fx-background-color: #e8f5e9; -fx-padding: 15; -fx-border-color: #c8e6c9; -fx-border-width: 1; -fx-border-radius: 5;"
                  spacing="10" GridPane.rowIndex="0" GridPane.columnIndex="0" VBox.vgrow="ALWAYS">
                <Label text="INGRESAR NUEVO PRODUCTO" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                <VBox spacing="10" style="-fx-padding: 10;">
                    <Label text="Nombre producto:"/>
                    <TextField fx:id="txtNombreProducto" prefWidth="300"/>

                    <Label text="Ingreso unidades (stock):"/>
                    <TextField fx:id="txtStock" prefWidth="150"/>

                    <Label text="Ingresar precio por unidad:"/>
                    <TextField fx:id="txtPrecio" prefWidth="150"/>
                </VBox>
                <Button text="Ingresar Producto" onAction="#handleIngresarProducto"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </VBox-->

            <!-- VENDER PRODUCTO -->
            <VBox style="-fx-background-color: #ffebee; -fx-padding: 15; -fx-border-color: #ffcdd2; -fx-border-width: 1; -fx-border-radius: 5;"
                  spacing="10" GridPane.rowIndex="0" GridPane.columnIndex="1" VBox.vgrow="ALWAYS">
                <Label text="VENDER PRODUCTO" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                <GridPane hgap="10" vgap="10" style="-fx-padding: 10 0;">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="150"/>
                        <ColumnConstraints prefWidth="200"/>
                    </columnConstraints>

                    <rowConstraints>
                        <RowConstraints prefHeight="30"/>
                        <RowConstraints prefHeight="30"/>
                        <RowConstraints prefHeight="30"/>
                    </rowConstraints>

                    <Label text="SELECCIONE PRODUCTO" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cbProductos" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="200"/>

                    <Label text="UNIDADES A VENDER" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="1" GridPane.columnIndex="1">
                        <Button text="-" onAction="#disminuirCantidad"/>
                        <Label fx:id="lblCantidad" text="1" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <Button text="+" onAction="#aumentarCantidad"/>
                    </HBox>

                    <Label text="TOTAL:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                    <Label fx:id="lblTotalVenta" GridPane.rowIndex="2" GridPane.columnIndex="1"
                           style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                </GridPane>
                <Button text="Agregar al Carrito" onAction="#handleAgregarAlCarrito"
                        style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </VBox>

            <!-- PRODUCTOS INGRESADOS -->
            <VBox style="-fx-background-color: #fffde7; -fx-padding: 15; -fx-border-color: #fff9c4; -fx-border-width: 1; -fx-border-radius: 5;"
                  spacing="10" GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.rowSpan="2" VBox.vgrow="ALWAYS">

                <Label text="PRODUCTOS INGRESADOS" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

                <!-- Tabla ocupa todo el espacio disponible -->
                <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn text="PRODUCTO" fx:id="colProducto" prefWidth="142" style="-fx-alignment: CENTER;"/>
                        <TableColumn text="UNIDADES" fx:id="colUnidades" prefWidth="100" style="-fx-alignment: CENTER;"/>
                        <TableColumn text="PRECIO" fx:id="colPrecio" prefWidth="100" style="-fx-alignment: CENTER;"/>
                    </columns>
                </TableView>

                <!-- Botones debajo de la tabla -->
                <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                    <Button text="Ingresar Producto" onAction="#handleIngresarProducto"
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Button text="Editar" onAction="#handleEditarProducto"
                            style="-fx-background-color: #ff9800; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Button text="Eliminar" onAction="#handleEliminarProducto"
                            style="-fx-background-color: #e53935; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>

            <!-- CARRITO DE VENTA -->
            <VBox style="-fx-background-color: #e3f2fd; -fx-padding: 15; -fx-border-color: #bbdefb; -fx-border-width: 1; -fx-border-radius: 5;"
                  spacing="10" GridPane.rowIndex="1" GridPane.columnIndex="1" VBox.vgrow="ALWAYS">
                <Label text="CARRITO DE VENTA" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                <TableView fx:id="tablaCarrito" prefHeight="200" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCarritoNombre" text="Producto"/>
                        <TableColumn fx:id="colCarritoUnidades" text="Unidades"/>
                        <TableColumn fx:id="colCarritoPrecio" text="P. Unitario"/>
                        <TableColumn fx:id="colCarritoTotal" text="Total"/>
                    </columns>
                </TableView>

                <!-- TOTAL -->
                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                    <Label text="TOTAL:" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Label fx:id="lblTotalCarrito" text="" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                </HBox>

                <Button text="Confirmar Venta" onAction="#handleConfirmarVenta"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </VBox>
        </GridPane>
    </center>
</BorderPane>