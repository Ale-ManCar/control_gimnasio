<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ProveedorDialogController"
            prefWidth="900" prefHeight="600"
            stylesheets="@../css/proveedor_dialog.css">
    <styleClass>
        <String fx:value="proveedor-dialog-root"/>
    </styleClass>
    <top>
        <VBox spacing="18" BorderPane.alignment="CENTER">
            <StackPane>
                <children>
                    <VBox spacing="18">
                        <styleClass>
                            <String fx:value="header-card"/>
                        </styleClass>
                        <children>
                            <HBox spacing="16" alignment="CENTER_LEFT">
                                <children>
                                    <StackPane>
                                        <styleClass>
                                            <String fx:value="header-badge"/>
                                        </styleClass>
                                        <children>
                                            <Label text="🛒">
                                                <styleClass>
                                                    <String fx:value="badge-emoji"/>
                                                </styleClass>
                                            </Label>
                                        </children>
                                    </StackPane>
                                    <VBox spacing="4">
                                        <children>
                                            <Label text="Registro de proveedor">
                                                <styleClass>
                                                    <String fx:value="title-label"/>
                                                </styleClass>
                                            </Label>
                                            <Label text="Agrega nuevos aliados comerciales y asigna los productos que pueden suministrar.">
                                                <styleClass>
                                                    <String fx:value="subtitle-label"/>
                                                </styleClass>
                                            </Label>
                                        </children>
                                    </VBox>
                                </children>
                            </HBox>
                            <GridPane hgap="14" vgap="14">
                                <styleClass>
                                    <String fx:value="form-grid"/>
                                </styleClass>
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="30"/>
                                    <ColumnConstraints percentWidth="70"/>
                                </columnConstraints>
                                <children>
                                    <Label text="Nombre" GridPane.rowIndex="0" GridPane.columnIndex="0">
                                        <styleClass>
                                            <String fx:value="input-label"/>
                                        </styleClass>
                                    </Label>
                                    <TextField fx:id="txtNombre" promptText="Nombre del proveedor" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                        <styleClass>
                                            <String fx:value="modern-field"/>
                                        </styleClass>
                                    </TextField>
                                    <Label text="Contacto" GridPane.rowIndex="1" GridPane.columnIndex="0">
                                        <styleClass>
                                            <String fx:value="input-label"/>
                                        </styleClass>
                                    </Label>
                                    <TextField fx:id="txtContacto" promptText="Persona de contacto" GridPane.rowIndex="1" GridPane.columnIndex="1">
                                        <styleClass>
                                            <String fx:value="modern-field"/>
                                        </styleClass>
                                    </TextField>
                                    <Label text="Teléfono" GridPane.rowIndex="2" GridPane.columnIndex="0">
                                        <styleClass>
                                            <String fx:value="input-label"/>
                                        </styleClass>
                                    </Label>
                                    <TextField fx:id="txtTelefono" promptText="Número telefónico" GridPane.rowIndex="2" GridPane.columnIndex="1">
                                        <styleClass>
                                            <String fx:value="modern-field"/>
                                        </styleClass>
                                    </TextField>
                                </children>
                            </GridPane>
                        </children>
                    </VBox>
                </children>
            </StackPane>
        </VBox>
    </top>
    <center>
        <VBox spacing="18" BorderPane.alignment="CENTER">
            <StackPane>
                <styleClass>
                    <String fx:value="content-card"/>
                </styleClass>
                <children>
                    <TabPane tabClosingPolicy="UNAVAILABLE">
                        <styleClass>
                            <String fx:value="accent-tabpane"/>
                        </styleClass>
                        <tabs>
                            <Tab text="Equipos">
                                <content>
                                    <VBox spacing="12">
                                        <styleClass>
                                            <String fx:value="tab-content"/>
                                        </styleClass>
                                        <children>
                                            <Label text="Selecciona los equipos que suministra el proveedor e indica su precio.">
                                                <styleClass>
                                                    <String fx:value="tab-description"/>
                                                </styleClass>
                                            </Label>
                                            <TableView fx:id="tablaEquipos" editable="true" VBox.vgrow="ALWAYS">
                                                <styleClass>
                                                    <String fx:value="glass-table"/>
                                                </styleClass>
                                                <columns>
                                                    <TableColumn fx:id="colEquipoSeleccion" text="Seleccionar" prefWidth="140"/>
                                                    <TableColumn fx:id="colEquipoNombre" text="Equipo" prefWidth="300"/>
                                                    <TableColumn fx:id="colEquipoPrecio" text="Precio" prefWidth="160"/>
                                                </columns>
                                            </TableView>
                                        </children>
                                    </VBox>
                                </content>
                            </Tab>
                            <Tab text="Insumos">
                                <content>
                                    <VBox spacing="12">
                                        <styleClass>
                                            <String fx:value="tab-content"/>
                                        </styleClass>
                                        <children>
                                            <Label text="Selecciona los insumos y registra su precio de compra.">
                                                <styleClass>
                                                    <String fx:value="tab-description"/>
                                                </styleClass>
                                            </Label>
                                            <TableView fx:id="tablaInsumos" editable="true" VBox.vgrow="ALWAYS">
                                                <styleClass>
                                                    <String fx:value="glass-table"/>
                                                </styleClass>
                                                <columns>
                                                    <TableColumn fx:id="colInsumoSeleccion" text="Seleccionar" prefWidth="140"/>
                                                    <TableColumn fx:id="colInsumoNombre" text="Insumo" prefWidth="300"/>
                                                    <TableColumn fx:id="colInsumoPrecio" text="Precio" prefWidth="160"/>
                                                </columns>
                                            </TableView>
                                        </children>
                                    </VBox>
                                </content>
                            </Tab>
                        </tabs>
                    </TabPane>
                </children>
            </StackPane>
        </VBox>
    </center>
    <bottom>
        <HBox spacing="16" alignment="CENTER_LEFT" BorderPane.alignment="CENTER">
            <styleClass>
                <String fx:value="footer-actions"/>
            </styleClass>
            <children>
                <Label text="Revisa la información antes de guardar los cambios." wrapText="true">
                    <styleClass>
                        <String fx:value="footer-note"/>
                    </styleClass>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnCancelar" text="Cancelar" onAction="#cancelar">
                    <styleClass>
                        <String fx:value="secondary-button"/>
                    </styleClass>
                </Button>
                <Button fx:id="btnGuardar" text="Guardar" onAction="#guardar">
                    <styleClass>
                        <String fx:value="primary-button"/>
                    </styleClass>
                </Button>
            </children>
        </HBox>
    </bottom>
</BorderPane>