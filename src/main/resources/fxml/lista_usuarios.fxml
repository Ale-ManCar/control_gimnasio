<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.UserManagementController" spacing="10"
      style="-fx-background-color: white; -fx-padding: 20;">
    <Label text="Usuarios" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    <TableView fx:id="tableUsers">
        <columns>
            <TableColumn text="Usuario" fx:id="colUsername" prefWidth="150" />
            <TableColumn text="Rol" fx:id="colRole" prefWidth="120" />
            <TableColumn text="Último Login" fx:id="colLastLogin" prefWidth="180" />
            <TableColumn text="Acciones" fx:id="colAcciones" prefWidth="100" />
        </columns>
    </TableView>
</VBox>