<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.MetricCardController"
            fx:id="root"
            styleClass="metric-card"
            prefWidth="200" prefHeight="120">
    <children>
        <VBox alignment="CENTER" spacing="8"
              AnchorPane.topAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0">
            <FontIcon fx:id="iconoMetric"
                      iconLiteral="fas-chart-line"
                      styleClass="metric-card__icon"/>
            <Label fx:id="lblTitulo" styleClass="metric-card__title"/>
            <Label fx:id="lblValor" styleClass="metric-card__value"/>
        </VBox>
    </children>
</AnchorPane>