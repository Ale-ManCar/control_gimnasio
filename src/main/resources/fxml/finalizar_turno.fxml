<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.FinalizarTurnoController" spacing="10" alignment="CENTER">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="Resumen del Turno" style="-fx-font-size:18px;-fx-font-weight:bold;"/>
    <GridPane hgap="10" vgap="10">
        <Label text="Ingresos ventas:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Label fx:id="lblIngresosVentas" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Ingresos clientes:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Label fx:id="lblIngresosClientes" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    </GridPane>
    <HBox spacing="10" alignment="CENTER">
        <Button text="Confirmar" onAction="#confirmar"/>
        <Button text="Cancelar" onAction="#cancelar"/>
    </HBox>
</VBox>