<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.XYChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ComparacionPreciosController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: linear-gradient(to bottom, #111827, #1f2937); -fx-padding: 20;">
    <top>
        <VBox spacing="12">
            <Label text="Comparación de precios entre proveedores"
                   style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Categoría" style="-fx-text-fill: #cbd5f5;"/>
                <ComboBox fx:id="cmbCategoria" prefWidth="180"/>
                <Label text="Producto" style="-fx-text-fill: #cbd5f5;"/>
                <ComboBox fx:id="cmbProducto" prefWidth="220"/>
                <Label fx:id="lblVariante" text="Variante" style="-fx-text-fill: #cbd5f5;"/>
                <ComboBox fx:id="cmbVariante" prefWidth="200"/>
                <Label text="Ordenar" style="-fx-text-fill: #cbd5f5;"/>
                <ComboBox fx:id="cmbOrden" prefWidth="180"/>
            </HBox>
            <Label fx:id="lblProductoSeleccionado" text="Selecciona un producto para iniciar la comparación"
                   style="-fx-text-fill: #94a3b8; -fx-font-style: italic;"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="15">
            <TableView fx:id="tablaComparacion" prefHeight="260"
                       style="-fx-background-color: rgba(17,24,39,0.85); -fx-border-color: rgba(148,163,184,0.3); -fx-border-radius: 12; -fx-background-radius: 12;">
                <columns>
                    <TableColumn fx:id="colProveedor" text="Proveedor" prefWidth="200"/>
                    <TableColumn fx:id="colContacto" text="Contacto" prefWidth="160"/>
                    <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="140"/>
                    <TableColumn fx:id="colPrecio" text="Precio" prefWidth="140"/>
                </columns>
            </TableView>
            <BarChart fx:id="graficaPrecios" title="Comparativa"
                      animated="false" legendVisible="false"
                      style="-fx-background-color: rgba(15,23,42,0.6); -fx-padding: 15; -fx-background-radius: 12; -fx-border-radius: 12;"
                      prefHeight="240">
                <xAxis>
                    <CategoryAxis fx:id="ejeProveedores" label="Proveedores"/>
                </xAxis>
                <yAxis>
                    <NumberAxis fx:id="ejePrecios" label="Precio"/>
                </yAxis>
            </BarChart>
        </VBox>
    </center>
    <bottom>
        <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
            <Button fx:id="btnVerDetalles" text="Ver detalles" onAction="#verDetallesProveedor"
                    style="-fx-background-color: #38bdf8; -fx-text-fill: white; -fx-background-radius: 18;"/>
            <Button fx:id="btnAgregarPedido" text="Agregar a pedido" onAction="#agregarAPedido"
                    style="-fx-background-color: linear-gradient(to right, #22c55e, #16a34a); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 18;"/>
        </HBox>
    </bottom>
</BorderPane>