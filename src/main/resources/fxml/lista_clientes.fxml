<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.ListaClientesController"
      spacing="20"
      style="-fx-padding: 25; -fx-background-color: #F8F9FA;"
      prefWidth="850" prefHeight="650">

    <!-- Encabezado con logo y título -->
    <HBox alignment="CENTER" spacing="15" style="-fx-padding: 0 0 20 0;">
        <Label fx:id="lblTitulo" text="Gestión de Clientes" />
    </HBox>

    <!-- Barra de búsqueda con estilos modernos -->
    <HBox spacing="10" style="-fx-padding: 0 0 20 0;" alignment="CENTER">
        <TextField fx:id="txtBuscar"
                   style="-fx-pref-width: 450px; -fx-font-size: 14px; -fx-padding: 8px 15px; -fx-background-radius: 20px; -fx-border-radius: 20px; -fx-border-color: #ced4da; -fx-background-color: #ffffff;"
                   promptText="Buscar por nombre, teléfono..."/>
        <Button fx:id="btnLimpiar" text="Limpiar" onAction="#limpiarFiltro"
                style="-fx-background-color: #6C757D; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8px 15px; -fx-background-radius: 20px; -fx-border-radius: 20px;"/>
    </HBox>

    <!-- Tabla con diseño moderno y bordes -->
    <TableView fx:id="tablaClientes"
               style="
                   -fx-background-radius: 10px;
                   -fx-scroll-bar-policy: never;
                   -fx-background-insets: 0;
                   -fx-padding: 0;
                   -fx-alignment: CENTER;
                   -fx-border-color: #e0e0e0;
                   -fx-border-width: 1px;
                   -fx-background-color: transparent;
                   -fx-table-cell-border-color: #e0e0e0;
               ">
        <columns>
            <TableColumn text="Cliente" fx:id="colNombreCompleto"
                         style="
                             -fx-alignment: CENTER;
                             -fx-text-alignment: center;
                             -fx-border-color: #e0e0e0;
                             -fx-border-width: 0 1px 0 0;
                             -fx-background-color: transparent;
                         "
                         prefWidth="340"/>
            <TableColumn text="Teléfono" fx:id="colTelefono"
                         style="
                             -fx-alignment: CENTER;
                             -fx-text-alignment: center;
                             -fx-border-color: #e0e0e0;
                             -fx-border-width: 0 1px 0 0;
                             -fx-background-color: transparent;
                         "
                         prefWidth="210"/>
            <TableColumn text="Estado" fx:id="colEstado"
                         style="
                             -fx-alignment: CENTER;
                             -fx-text-alignment: center;
                             -fx-border-color: #e0e0e0;
                             -fx-border-width: 0 1px 0 0;
                             -fx-background-color: transparent;
                         "
                         prefWidth="170"/>
            <TableColumn text="Acciones" fx:id="colAcciones"
                         style="
                             -fx-alignment: CENTER;
                             -fx-text-alignment: center;
                             -fx-background-color: transparent;
                         "
                         prefWidth="130"/>
        </columns>
    </TableView>

    <!-- Botones: Volver y Ver Inactivos -->
    <HBox spacing="20" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
        <Button text="Volver al Dashboard" onAction="#handleVolver"
                style="-fx-background-color: #4A6CF7; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 220; -fx-font-size: 16px; -fx-padding: 10px 25px; -fx-background-radius: 25px; -fx-border-radius: 25px; -fx-cursor: hand;"/>

        <Button text="Ver Clientes Inactivos" onAction="#handleVerInactivos"
                style="-fx-background-color: #c30010; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 220; -fx-font-size: 16px; -fx-padding: 10px 25px; -fx-background-radius: 25px; -fx-border-radius: 25px; -fx-cursor: hand;"/>
    </HBox>
</VBox>