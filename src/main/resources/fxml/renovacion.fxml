<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.RenovacionController"
            prefWidth="800" prefHeight="600" style="-fx-background-color: linear-gradient(to bottom, #2c3e50, #1a1a2e); -fx-padding: 15;">
    <top>
        <Label text="Renovación de Membresías"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white; -fx-padding: 0 0 10 0;"
               alignment="CENTER" maxWidth="Infinity"/>
    </top>
    <center>
        <GridPane hgap="15" vgap="15">
            <columnConstraints>
                <ColumnConstraints percentWidth="60"/>
                <ColumnConstraints percentWidth="40"/>
            </columnConstraints>

            <!-- TABLA CLIENTES -->
            <VBox GridPane.columnIndex="0">
                <HBox alignment="CENTER" spacing="10" style="-fx-padding: 0 0 10 0;">
                    <TextField fx:id="txtBuscar" promptText="Buscar cliente..."
                               style="-fx-pref-width: 250px; -fx-font-size: 12px; -fx-background-color: rgba(255,255,255,0.9);"/>
                    <Button text="Filtrar" onAction="#filtrarClientes"
                            style="-fx-background-color: linear-gradient(to right, #2196F3, #3498db); -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-padding: 5 10; -fx-background-radius: 25;"/>
                    <Button text="Limpiar" onAction="#limpiarFiltro"
                            style="-fx-background-color: #6C757D; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-padding: 5 10; -fx-background-radius: 25;"/>
                </HBox>
                <TableView fx:id="tablaClientes" prefHeight="300"
                           style="
                           -fx-text-background-color: #333333;
                           -fx-control-inner-background: rgba(255,255,255,0.9);
                           -fx-table-cell-border-color: transparent;
                           -fx-background-insets: 0;
                           -fx-padding: 0;
                           -fx-background-radius: 15;
                           -fx-border-radius: 15;
                           -fx-border-width: 0;
                           -fx-table-header-border-color: transparent;">
                    <columns>
                        <TableColumn text="Nombre" prefWidth="150" style="-fx-text-fill: #2c3e50; -fx-border-width: 0;">
                            <cellValueFactory><PropertyValueFactory property="nombreCompleto"/></cellValueFactory>
                        </TableColumn>
                        <TableColumn text="Teléfono" prefWidth="100" style="-fx-text-fill: #2c3e50; -fx-border-width: 0;">
                            <cellValueFactory><PropertyValueFactory property="telefonoVisible"/></cellValueFactory>
                        </TableColumn>
                        <TableColumn text="Vence" prefWidth="80" style="-fx-text-fill: #2c3e50; -fx-border-width: 0;">
                            <cellValueFactory><PropertyValueFactory property="fecha_vencimiento"/></cellValueFactory>
                        </TableColumn>
                        <TableColumn text="Días" prefWidth="50" style="-fx-text-fill: #2c3e50; -fx-border-width: 0;">
                            <cellValueFactory><PropertyValueFactory property="diasRestantes"/></cellValueFactory>
                        </TableColumn>
                    </columns>
                </TableView>
                <HBox alignment="CENTER" spacing="10" style="-fx-padding: 10 0;">
                    <Button text="&lt; Anterior" fx:id="btnAnterior" onAction="#paginaAnterior"
                            style="-fx-padding: 5 10; -fx-background-radius: 25; -fx-background-color: #6C757D; -fx-text-fill: white;"/>
                    <Label fx:id="lblPagina" text="Página 1 de 1" style="-fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Button text="Siguiente &gt;" fx:id="btnSiguiente" onAction="#paginaSiguiente"
                            style="-fx-padding: 5 10; -fx-background-radius: 25; -fx-background-color: #6C757D; -fx-text-fill: white;"/>
                </HBox>
            </VBox>

            <!-- PANEL DERECHO -->
            <VBox fx:id="panelDerecho" GridPane.columnIndex="1" spacing="18"
                  style="-fx-background-color: rgba(255,255,255,0.95); -fx-padding: 18; -fx-background-radius: 18;
                         -fx-border-radius: 18; -fx-border-color: rgba(44,62,80,0.08); -fx-border-width: 1;">
                <Label fx:id="lblInfoCliente" text="Selecciona un cliente para comenzar"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-wrap-text: true; -fx-text-fill: #2c3e50;"/>

                <VBox spacing="10" style="-fx-background-color: rgba(33,150,243,0.08); -fx-padding: 14; -fx-background-radius: 14;">
                    <Label text="Información del cliente" style="-fx-text-fill: #1565c0; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                    <Label fx:id="lblNombreCliente" text="-"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1b2a49;"/>
                    <GridPane hgap="10" vgap="6">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" percentWidth="45"/>
                            <ColumnConstraints halignment="LEFT" percentWidth="55"/>
                        </columnConstraints>
                        <Label text="Teléfono:" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
                        <Label fx:id="lblTelefonoCliente" text="-" GridPane.columnIndex="1"
                               style="-fx-text-fill: #2c3e50;"/>
                        <Label text="Membresía actual:" GridPane.rowIndex="1"
                               style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
                        <Label fx:id="lblMembresiaActual" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1"
                               style="-fx-text-fill: #2c3e50;"/>
                        <Label text="Vence el:" GridPane.rowIndex="2"
                               style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
                        <Label fx:id="lblFechaVencimiento" text="-" GridPane.rowIndex="2" GridPane.columnIndex="1"
                               style="-fx-text-fill: #2c3e50;"/>
                    </GridPane>
                    <Label fx:id="lblEstadoCuenta"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6 12; -fx-background-radius: 12;"
                           text="Estado no disponible"/>
                    <Label fx:id="lblDiasRestantes" wrapText="true"
                           style="-fx-text-fill: #2c3e50; -fx-font-size: 12px;"/>
                </VBox>

                <VBox spacing="12" style="-fx-background-color: rgba(236,239,241,0.7); -fx-padding: 16; -fx-background-radius: 14;">
                    <Label text="Configurar renovación" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                    <GridPane hgap="10" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints halignment="LEFT" percentWidth="40"/>
                            <ColumnConstraints halignment="LEFT" percentWidth="60"/>
                        </columnConstraints>
                        <Label text="Nueva Membresía" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
                        <ComboBox fx:id="cbNuevaMembresia" prefWidth="150" GridPane.columnIndex="1"
                                  style="-fx-background-color: rgba(255,255,255,0.95);"/>
                        <Label text="Fecha de Renovación" GridPane.rowIndex="1"
                               style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
                        <DatePicker fx:id="dpFechaRenovacion" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                    style="-fx-background-color: rgba(255,255,255,0.95);"/>
                        <Label text="Monto" GridPane.rowIndex="2"
                               style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
                        <VBox spacing="4" GridPane.rowIndex="2" GridPane.columnIndex="1">
                            <TextField fx:id="txtMonto" promptText="Ingrese el monto"
                                       style="-fx-background-color: rgba(255,255,255,0.95);"/>
                            <Label text="Ingresa el valor a cobrar al cliente." style="-fx-text-fill: #607d8b; -fx-font-size: 11px;"/>
                        </VBox>
                    </GridPane>
                    <Button text="Renovar" onAction="#handleRenovar" maxWidth="Infinity"
                            style="-fx-background-color: linear-gradient(to right, #4CAF50, #2ECC71); -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-padding: 10 15; -fx-background-radius: 25;"/>
                </VBox>

                <VBox spacing="10" style="-fx-background-color: rgba(255,255,255,0.85); -fx-padding: 14; -fx-background-radius: 14;">
                    <Label text="Historial de pagos" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
                    <TableView fx:id="tablaHistorial" prefHeight="150"
                               style="
                               -fx-text-background-color: #333333;
                               -fx-control-inner-background: rgba(255,255,255,0.95);
                               -fx-table-cell-border-color: transparent;
                               -fx-background-insets: 0;
                               -fx-padding: 0;
                               -fx-background-radius: 12;
                               -fx-border-radius: 12;
                               -fx-border-width: 0;
                               -fx-table-header-border-color: transparent;">
                        <columns>
                            <TableColumn text="Fecha" prefWidth="80" style="-fx-text-fill: #2c3e50; -fx-border-width: 0;">
                                <cellValueFactory><PropertyValueFactory property="fechaPago"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Membresía" prefWidth="100" style="-fx-text-fill: #2c3e50; -fx-border-width: 0;">
                                <cellValueFactory><PropertyValueFactory property="tipoMembresia"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn text="Monto" prefWidth="70" style="-fx-text-fill: #2c3e50; -fx-border-width: 0;">
                                <cellValueFactory><PropertyValueFactory property="monto"/></cellValueFactory>
                            </TableColumn>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </GridPane>
    </center>
</BorderPane>
