<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
		xmlns="http://jasperreports.sourceforge.net/jasperreports"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
		name="reporte_financiero"
		language="java"
		pageWidth="595"
		pageHeight="842"
		columnWidth="555"
		leftMargin="20"
		rightMargin="20"
		topMargin="20"
		bottomMargin="20"
		uuid="e73b923e-d8e0-437a-9cc5-c43cc7a35117">

	<!-- Parámetros para los totales -->
	<parameter name="totalMembresias" class="java.lang.Double"/>
	<parameter name="totalVentas" class="java.lang.Double"/>
	<parameter name="totalEgresos" class="java.lang.Double"/>
	<parameter name="resultadoNeto" class="java.lang.Double"/>
	<parameter name="mesReporte" class="java.lang.Integer"/>
	<parameter name="anioReporte" class="java.lang.Integer"/>

	<!-- Campos para el detalle de egresos -->
	<field name="descripcion" class="java.lang.String"/>
	<field name="categoria" class="java.lang.String"/>
	<field name="monto" class="java.lang.Double"/>
	<field name="fecha" class="java.time.LocalDate"/>

	<title>
		<band height="80">
			<rectangle>
				<reportElement x="0" y="0" width="555" height="80" backcolor="#3F51B5"/>
			</rectangle>
			<staticText>
				<reportElement x="0" y="20" width="555" height="30" forecolor="#FFFFFF"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="22" isBold="true"/>
				</textElement>
				<text><![CDATA[REPORTE FINANCIERO MENSUAL]]></text>
			</staticText>

			<textField>
				<reportElement x="0" y="50" width="555" height="20" forecolor="#FFFFFF"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[
                    java.time.Month.of($P{mesReporte}).getDisplayName(
                        java.time.format.TextStyle.FULL,
                        new java.util.Locale("es")
                    ).toUpperCase() + " " + $P{anioReporte}
                ]]></textFieldExpression>
			</textField>
		</band>
	</title>

	<pageHeader>
		<band height="10">
			<line>
				<reportElement x="0" y="5" width="555" height="1"/>
				<graphicElement>
					<pen lineWidth="0.5" lineColor="#E0E0E0"/>
				</graphicElement>
			</line>
		</band>
	</pageHeader>

	<columnHeader>
		<band height="30">
			<staticText>
				<reportElement x="0" y="0" width="200" height="30" backcolor="#3F51B5" mode="Opaque" forecolor="#FFFFFF"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Descripción]]></text>
			</staticText>
			<staticText>
				<reportElement x="200" y="0" width="120" height="30" backcolor="#3F51B5" mode="Opaque" forecolor="#FFFFFF"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Categoría]]></text>
			</staticText>
			<staticText>
				<reportElement x="320" y="0" width="100" height="30" backcolor="#3F51B5" mode="Opaque" forecolor="#FFFFFF"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Fecha]]></text>
			</staticText>
			<staticText>
				<reportElement x="420" y="0" width="135" height="30" backcolor="#3F51B5" mode="Opaque" forecolor="#FFFFFF"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="11" isBold="true"/>
				</textElement>
				<text><![CDATA[Monto]]></text>
			</staticText>
		</band>
	</columnHeader>

	<detail>
		<band height="25" splitType="Stretch">
			<textField isStretchWithOverflow="true">
				<reportElement x="0" y="0" width="200" height="25" positionType="Float"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{descripcion}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="200" y="0" width="120" height="25" positionType="Float"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{categoria}]]></textFieldExpression>
			</textField>
			<textField pattern="dd/MM/yyyy">
				<reportElement x="320" y="0" width="100" height="25" positionType="Float"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{fecha}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="420" y="0" width="135" height="25" positionType="Float"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA["$" + new java.text.DecimalFormat("#,##0.00").format($F{monto})]]></textFieldExpression>
			</textField>
		</band>
	</detail>

	<columnFooter>
		<band height="0"/>
	</columnFooter>

	<pageFooter>
		<band height="30">
			<textField>
				<reportElement x="0" y="10" width="555" height="20"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de " + $V{PAGE_COUNT}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>

	<summary>
		<band height="220">
			<staticText>
				<reportElement x="0" y="10" width="555" height="25" forecolor="#3F51B5"/>
				<textElement textAlignment="Center">
					<font size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[RESUMEN FINANCIERO]]></text>
			</staticText>

			<rectangle>
				<reportElement x="50" y="45" width="455" height="150" backcolor="#F9F9F9"/>
				<graphicElement>
					<pen lineWidth="0.5" lineColor="#E0E0E0"/>
				</graphicElement>
			</rectangle>

			<staticText>
				<reportElement x="70" y="60" width="200" height="20"/>
				<textElement textAlignment="Left">
					<font size="12" isBold="false"/>
				</textElement>
				<text><![CDATA[Total Membresías:]]></text>
			</staticText>
			<textField>
				<reportElement x="270" y="60" width="150" height="20"/>
				<textElement textAlignment="Right">
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["$" + new java.text.DecimalFormat("#,##0.00").format($P{totalMembresias})]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement x="70" y="85" width="200" height="20"/>
				<textElement textAlignment="Left">
					<font size="12" isBold="false"/>
				</textElement>
				<text><![CDATA[Total Ventas:]]></text>
			</staticText>
			<textField>
				<reportElement x="270" y="85" width="150" height="20"/>
				<textElement textAlignment="Right">
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["$" + new java.text.DecimalFormat("#,##0.00").format($P{totalVentas})]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement x="70" y="110" width="200" height="20"/>
				<textElement textAlignment="Left">
					<font size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[Total Ingresos:]]></text>
			</staticText>
			<textField>
				<reportElement x="270" y="110" width="150" height="20"/>
				<textElement textAlignment="Right">
					<font size="12" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["$" + new java.text.DecimalFormat("#,##0.00").format($P{totalMembresias} + $P{totalVentas})]]></textFieldExpression>
			</textField>

			<line>
				<reportElement x="70" y="135" width="350" height="1"/>
				<graphicElement>
					<pen lineWidth="0.5" lineColor="#E0E0E0" lineStyle="Dashed"/>
				</graphicElement>
			</line>

			<staticText>
				<reportElement x="70" y="140" width="200" height="20"/>
				<textElement textAlignment="Left">
					<font size="12" isBold="false"/>
				</textElement>
				<text><![CDATA[Total Egresos:]]></text>
			</staticText>
			<textField>
				<reportElement x="270" y="140" width="150" height="20"/>
				<textElement textAlignment="Right">
					<font size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["$" + new java.text.DecimalFormat("#,##0.00").format($P{totalEgresos})]]></textFieldExpression>
			</textField>

			<line>
				<reportElement x="70" y="165" width="350" height="1"/>
				<graphicElement>
					<pen lineWidth="1.0" lineColor="#3F51B5"/>
				</graphicElement>
			</line>

			<staticText>
				<reportElement x="70" y="170" width="200" height="25"/>
				<textElement textAlignment="Left">
					<font size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[Resultado Neto:]]></text>
			</staticText>
			<textField>
				<reportElement x="270" y="170" width="150" height="25"/>
				<textElement textAlignment="Right">
					<font size="14" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA["$" + new java.text.DecimalFormat("#,##0.00").format($P{resultadoNeto})]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>