<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="equipos_resumen" pageWidth="595" pageHeight="842" columnWidth="515"
              leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30">
    <style name="Base" fontName="SansSerif" fontSize="10" isDefault="true"/>
    <style name="TitleText" style="Base" forecolor="#FFFFFF" fontSize="20" isBold="true"/>
    <style name="SubtitleText" style="Base" forecolor="#D7E3FF" fontSize="12"/>
    <style name="InfoText" style="Base" forecolor="#E9EEFF" fontSize="9"/>
    <style name="SectionCaption" style="Base" forecolor="#1F3F81" fontSize="11" isBold="true"/>
    <style name="TableHeader" style="Base" mode="Opaque" backcolor="#274B8A" forecolor="#FFFFFF" fontSize="10" isBold="true">
        <box>
            <pen lineWidth="0.5" lineColor="#1F3F81"/>
        </box>
    </style>
    <style name="TableRow" style="Base" mode="Opaque" backcolor="#F4F7FF">
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
            <style mode="Opaque" backcolor="#FFFFFF"/>
        </conditionalStyle>
        <box>
            <pen lineWidth="0.25" lineColor="#D0DAF7"/>
        </box>
    </style>
    <style name="SummaryFrame" mode="Opaque" backcolor="#E9EEFF">
        <box>
            <pen lineWidth="0.75" lineColor="#274B8A"/>
        </box>
    </style>
    <style name="SummaryLabel" style="Base" forecolor="#274B8A" fontSize="10" isBold="true"/>
    <style name="SummaryValue" style="Base" forecolor="#1F3F81" fontSize="12" isBold="true"/>
    <parameter name="periodo" class="java.lang.String"/>
    <parameter name="generadoEn" class="java.lang.String"/>
    <field name="nombre" class="java.lang.String"/>
    <field name="tipo" class="java.lang.String"/>
    <field name="cantidadInicial" class="java.lang.Integer"/>
    <field name="altas" class="java.lang.Integer"/>
    <field name="bajas" class="java.lang.Integer"/>
    <field name="variacion" class="java.lang.Integer"/>
    <field name="cantidadFinal" class="java.lang.Integer"/>
    <field name="fechaUltimoCambio" class="java.lang.String"/>
    <variable name="totalAltas" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{altas}]]></variableExpression>
    </variable>
    <variable name="totalBajas" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{bajas}]]></variableExpression>
    </variable>
    <variable name="totalVariacion" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{variacion}]]></variableExpression>
    </variable>
    <variable name="totalFinal" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{cantidadFinal}]]></variableExpression>
    </variable>
    <background>
        <band splitType="Stretch">
            <rectangle>
                <reportElement x="-40" y="-30" width="675" height="872" mode="Opaque" backcolor="#F7F9FC"/>
            </rectangle>
        </band>
    </background>
    <title>
        <band height="120">
            <rectangle>
                <reportElement x="0" y="0" width="515" height="80" mode="Opaque" backcolor="#14274E"/>
            </rectangle>
            <staticText style="TitleText">
                <reportElement x="0" y="12" width="515" height="26"/>
                <text><![CDATA[Informe histórico de equipos]]></text>
            </staticText>
            <textField style="SubtitleText">
                <reportElement x="0" y="42" width="515" height="18"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$P{periodo}]]></textFieldExpression>
            </textField>
            <textField style="InfoText">
                <reportElement x="0" y="60" width="515" height="14"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA["Generado: " + $P{generadoEn}]]></textFieldExpression>
            </textField>
            <frame>
                <reportElement x="0" y="86" width="515" height="28" style="SummaryFrame"/>
                <staticText style="SummaryLabel">
                    <reportElement x="16" y="6" width="250" height="16"/>
                    <text><![CDATA[Resumen consolidado de movimientos por equipo]]></text>
                </staticText>
            </frame>
        </band>
    </title>
    <columnHeader>
        <band height="32">
            <rectangle>
                <reportElement x="0" y="0" width="515" height="28" mode="Opaque" backcolor="#1F3F81"/>
            </rectangle>
            <staticText style="TableHeader">
                <reportElement x="0" y="0" width="120" height="28"/>
                <textElement verticalAlignment="Middle"/>
                <text><![CDATA[Equipo]]></text>
            </staticText>
            <staticText style="TableHeader">
                <reportElement x="120" y="0" width="70" height="28"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Tipo]]></text>
            </staticText>
            <staticText style="TableHeader">
                <reportElement x="190" y="0" width="55" height="28"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Inicio]]></text>
            </staticText>
            <staticText style="TableHeader">
                <reportElement x="245" y="0" width="45" height="28"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Altas]]></text>
            </staticText>
            <staticText style="TableHeader">
                <reportElement x="290" y="0" width="45" height="28"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Bajas]]></text>
            </staticText>
            <staticText style="TableHeader">
                <reportElement x="335" y="0" width="50" height="28"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Variación]]></text>
            </staticText>
            <staticText style="TableHeader">
                <reportElement x="385" y="0" width="50" height="28"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Final]]></text>
            </staticText>
            <staticText style="TableHeader">
                <reportElement x="435" y="0" width="80" height="28"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[Último cambio]]></text>
            </staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="22">
            <textField style="TableRow">
                <reportElement x="0" y="0" width="120" height="22"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression>
            </textField>
            <textField style="TableRow">
                <reportElement x="120" y="0" width="70" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{tipo}]]></textFieldExpression>
            </textField>
            <textField style="TableRow" pattern="###">
                <reportElement x="190" y="0" width="55" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{cantidadInicial}]]></textFieldExpression>
            </textField>
            <textField style="TableRow" pattern="###">
                <reportElement x="245" y="0" width="45" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{altas}]]></textFieldExpression>
            </textField>
            <textField style="TableRow" pattern="###">
                <reportElement x="290" y="0" width="45" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{bajas}]]></textFieldExpression>
            </textField>
            <textField style="TableRow" pattern="+#;-#;0">
                <reportElement x="335" y="0" width="50" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{variacion}]]></textFieldExpression>
            </textField>
            <textField style="TableRow" pattern="###">
                <reportElement x="385" y="0" width="50" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{cantidadFinal}]]></textFieldExpression>
            </textField>
            <textField style="TableRow">
                <reportElement x="435" y="0" width="80" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{fechaUltimoCambio}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    <summary>
        <band height="90">
            <frame>
                <reportElement x="0" y="10" width="515" height="60" style="SummaryFrame"/>
                <staticText style="SummaryLabel">
                    <reportElement x="10" y="8" width="90" height="16"/>
                    <text><![CDATA[Equipos listados]]></text>
                </staticText>
                <textField style="SummaryValue">
                    <reportElement x="10" y="30" width="90" height="20"/>
                    <textElement textAlignment="Center"/>
                    <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
                </textField>
                <staticText style="SummaryLabel">
                    <reportElement x="110" y="8" width="80" height="16"/>
                    <text><![CDATA[Altas registradas]]></text>
                </staticText>
                <textField style="SummaryValue" pattern="###">
                    <reportElement x="110" y="30" width="80" height="20"/>
                    <textElement textAlignment="Center"/>
                    <textFieldExpression><![CDATA[$V{totalAltas}]]></textFieldExpression>
                </textField>
                <staticText style="SummaryLabel">
                    <reportElement x="200" y="8" width="80" height="16"/>
                    <text><![CDATA[Bajas registradas]]></text>
                </staticText>
                <textField style="SummaryValue" pattern="###">
                    <reportElement x="200" y="30" width="80" height="20"/>
                    <textElement textAlignment="Center"/>
                    <textFieldExpression><![CDATA[$V{totalBajas}]]></textFieldExpression>
                </textField>
                <staticText style="SummaryLabel">
                    <reportElement x="290" y="8" width="90" height="16"/>
                    <text><![CDATA[Variación neta]]></text>
                </staticText>
                <textField style="SummaryValue" pattern="+#;-#;0">
                    <reportElement x="290" y="30" width="90" height="20"/>
                    <textElement textAlignment="Center"/>
                    <textFieldExpression><![CDATA[$V{totalVariacion}]]></textFieldExpression>
                </textField>
                <staticText style="SummaryLabel">
                    <reportElement x="390" y="8" width="110" height="16"/>
                    <text><![CDATA[Inventario final]]></text>
                </staticText>
                <textField style="SummaryValue" pattern="###">
                    <reportElement x="390" y="30" width="110" height="20"/>
                    <textElement textAlignment="Center"/>
                    <textFieldExpression><![CDATA[$V{totalFinal}]]></textFieldExpression>
                </textField>
            </frame>
        </band>
    </summary>
</jasperReport>
